# Copy this file to .env and fill in the values. .env is ignored by git.

# Required: Gemini key for transcription, grading and chat (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Required: OAuth 2.0 Web client ID for Google sign-in
GOOGLE_CLIENT_ID=

# Recommended: signs session tokens. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Optional: Bodhan key, needed only for text-to-speech in Agent Chat
BODHAN_API_KEY=

# Optional: comma-separated email domains allowed to sign in (unset = allow all)
# GOOGLE_ALLOWED_DOMAINS=
